config_version=5

[application]

config/name="MultiplayerTemplate"
run/main_scene="uid://gjuft281lsbu"
config/features=PackedStringArray("4.4", "Forward Plus")
run/max_fps=60
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/game/gamestate.gd"
